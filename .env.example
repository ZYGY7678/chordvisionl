# ChordVision configuration.
# Copy to .env and fill in. This file must never contain a real secret.

# --- required in production -------------------------------------------------

# Encrypts the transcription API keys your users store, and signs the
# identity cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it makes every stored API key undecryptable and signs every
# user out, so set it once and keep it.
CHORDVISION_SECRET_KEY=

# development | production
CHORDVISION_ENVIRONMENT=development

# --- storage ----------------------------------------------------------------

# SQLite needs nothing installed and is the default.
# PostgreSQL, for anything with more than one user:
#   CHORDVISION_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/chordvision
CHORDVISION_DATABASE_URL=sqlite:///./chordvision.db

# Where uploaded audio is written. This is only a temporary local working cache.
CHORDVISION_STORAGE_DIR=./storage

# Permanent production storage (configure privately in Render):
CHORDVISION_SUPABASE_URL=https://ikgyozgzhjbdmopsaflp.supabase.co
CHORDVISION_SUPABASE_STORAGE_BUCKET=chordvision-audio
CHORDVISION_SUPABASE_SERVICE_ROLE_KEY=
# CHORDVISION_DATABASE_URL should use:
# postgresql+psycopg://postgres:<DB_PASSWORD>@<DB_HOST>:5432/postgres
# Keep the database URI and service-role key private; never commit them.

CHORDVISION_MAX_UPLOAD_BYTES=125829120
CHORDVISION_MAX_AUDIO_SECONDS=1200

# --- analysis ---------------------------------------------------------------

# Analysis processes. Each one uses a full core while it runs.
CHORDVISION_ANALYSIS_WORKERS=2

# Chord vocabulary: triads | triads_ext | sevenths | full
# "sevenths" is the default. "full" adds 9ths, 11ths and 13ths, which are
# rarer and whose templates fit almost any chroma vector, so it lowers
# accuracy on ordinary songs - see docs/ACCURACY.md.
CHORDVISION_QUALITY_SET=sevenths

# --- web --------------------------------------------------------------------

# Where the frontend is served from during development.
CHORDVISION_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

CHORDVISION_RATE_LIMIT_PER_MINUTE=60
CHORDVISION_UPLOAD_RATE_LIMIT_PER_HOUR=30

# --- transcription ----------------------------------------------------------

# Seconds to wait for a transcription provider before giving up.
CHORDVISION_TRANSCRIPTION_TIMEOUT_S=600

# NOTE: transcription API keys are NOT configured here. Each user enters
# their own key in the app's settings screen, and it is encrypted with
# CHORDVISION_SECRET_KEY before it touches the database. Never put a
# provider key in this file.

# --- deploying -----------------------------------------------------------------
# On Render none of this file is used: render.yaml sets every variable.
# See DEPLOY_RENDER.md.
